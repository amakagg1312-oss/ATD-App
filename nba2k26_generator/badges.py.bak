"""Badge generation system for NBA 2K26.

Stat-driven gates determine WHO gets a badge.
Attribute + stat composites determine WHAT TIER.

Strict caps: max 1 Legend, max 3 HOF, max 20 total.
No OVR gating — a 72 OVR 3&D specialist gets their defensive badges.
"""

import os
import re
from typing import Any, Dict, List, Optional, Tuple


# ── Badge tier definitions ────────────────────────────────────────────────

BADGE_TIER_ORDER = ["Bronze", "Silver", "Gold", "HOF", "Legend"]

BADGE_TIER_THRESHOLDS = {
    "Bronze": 45.0,
    "Silver": 57.0,
    "Gold": 68.0,
    "HOF": 80.0,
    "Legend": 91.0,
}

BADGE_MAX_TOTAL = 20
BADGE_MAX_LEGEND = 1
BADGE_MAX_HOF = 3


# ── Position caps: max tier per badge per position ────────────────────────
# None = cannot receive badge at all
# "Legend" = uncapped (only limited by global caps)

